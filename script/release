#!/usr/bin/env bash
#
# Cut a release tag for the Go sub-module.
#
# Usage:
#   script/release <patch|minor|major>
#   script/release <patch|minor|major> --rc
#
# The next version is computed from the latest vX.Y.Z tag and the chosen
# bump. Maintainers run this locally to validate and push an annotated tag.
# The tag workflow publishes it.
#
# Environment:
#   RELEASE_DRY_RUN=1   Compute and print the next version, then stop before
#                       tagging or pushing.
#
# After a stable tag, it waits for the tag workflow and opens the pull request
# that stamps actions/verify on main for it, with your gh credentials so its
# checks run. The next release waits for that pull request to merge; a rerun
# before then reopens or reuses it.
#
# Requires: git, gh, go, make, node (see RELEASING.md).

set -euo pipefail

TAG_PREFIX="v"
STABLE_TAG_RE='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
TAG_RE='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?$'

die() {
  echo "error: $*" >&2
  exit 1
}

# Run from the repository root regardless of the caller's cwd.
cd "$(dirname "$0")/.."

validate_tag() {
  [[ "$1" =~ $TAG_RE ]] ||
    die "invalid release tag '$1'; expected vX.Y.Z or vX.Y.Z-rc.N"
}

fetch_main() {
  git fetch --quiet --no-tags origin refs/heads/main:refs/remotes/origin/main
}

require_current_main() {
  local commit="$1"
  local main
  fetch_main
  main="$(git rev-parse refs/remotes/origin/main)"
  [ "$commit" = "$main" ] ||
    die "release commit ${commit} is not current main ${main}"
}

stamped_version() {
  (git show "$1:actions/verify/checksums.json" 2>/dev/null || true) |
    node -e 'let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => { try { process.stdout.write(String(JSON.parse(s).version)); } catch {} });'
}

# The verify action on main must carry the latest release's stamp before the
# next release. The stamp can't land with its own release: the binaries embed the
# commit they're built from, so their checksums only exist after the tag.
main_stamped_for() {
  [ "$(stamped_version refs/remotes/origin/main)" = "$1" ]
}

# open_stamp_pr waits for tag's release workflow, then commits the stamp on a
# verify-stamp-<tag> branch off main and opens its pull request. Each step
# reuses what an earlier run left.
open_stamp_pr() {
  local tag="$1"
  local branch="verify-stamp-${tag}"
  fetch_main
  if main_stamped_for "$tag"; then
    echo "main is already stamped for ${tag}."
    return
  fi

  local run="" _
  for _ in $(seq 30); do
    run="$(gh run list --workflow release.yml --branch "$tag" --limit 1 --json databaseId --jq '.[0].databaseId // empty')"
    [ -n "$run" ] && break
    sleep 10
  done
  [ -n "$run" ] || die "no release workflow run found for ${tag}"
  echo "Waiting for the release workflow for ${tag}..."
  gh run watch "$run" --exit-status --compact >&2 ||
    die "the release workflow for ${tag} failed; fix it, then rerun"

  # Stamp off main on every run. An earlier stamp branch is reused only when it
  # changes nothing but checksums.json and holds the same verified checksums, so
  # commits landing on main in the meantime don't break a rerun.
  local file=actions/verify/checksums.json existing="" wt sha
  if git ls-remote --exit-code --heads origin "refs/heads/${branch}" >/dev/null; then
    git fetch --quiet --no-tags origin "refs/heads/${branch}:refs/remotes/origin/${branch}"
    existing="refs/remotes/origin/${branch}"
  fi
  wt="$(mktemp -d)"
  git worktree add --quiet --detach "$wt" refs/remotes/origin/main
  if ! (cd "$wt" &&
    node script/verify-action-release.mjs --stamp-only "$tag" &&
    git commit --quiet -am "Stamp actions/verify on main for ${tag}"); then
    git worktree remove --force "$wt"
    die "couldn't stamp ${branch}"
  fi
  if [ -n "$existing" ]; then
    if [ "$(git -C "$wt" rev-parse "HEAD:${file}")" != "$(git rev-parse "${existing}:${file}" 2>/dev/null)" ] ||
      [ "$(git diff --name-only "$(git merge-base refs/remotes/origin/main "$existing")" "$existing" 2>/dev/null)" != "$file" ]; then
      git worktree remove --force "$wt"
      die "branch ${branch} isn't the verified stamp for ${tag}; delete it (which closes its pull request) and rerun"
    fi
    sha="$(git rev-parse "$existing")"
  elif ! git -C "$wt" push --quiet origin "HEAD:refs/heads/${branch}"; then
    git worktree remove --force "$wt"
    die "couldn't push ${branch}"
  else
    sha="$(git -C "$wt" rev-parse HEAD)"
  fi
  git worktree remove --force "$wt"

  # --head also matches fork branches, so only reuse this repository's branch.
  local url
  url="$(gh pr list --head "$branch" --base main --state open \
    --json url,isCrossRepository,headRefOid \
    --jq "[.[] | select((.isCrossRepository | not) and .headRefOid == \"${sha}\")][0].url // empty")"
  [ -n "$url" ] || url="$(gh pr create --base main --head "$branch" \
    --title "Stamp actions/verify on main for ${tag}" \
    --body "Records ${tag} and its release binaries' checksums in \`actions/verify/checksums.json\`, so the next release can be cut.")"
  echo "Stamp pull request: ${url}"
}

require_clean() {
  if [ -n "$(git status --porcelain)" ]; then
    git --no-pager status --short >&2
    die "working tree is not clean"
  fi
}

require_remote_annotated_tag() {
  local tag="$1"
  local commit="$2"
  local remote_commit
  remote_commit="$(git ls-remote --tags origin "refs/tags/${tag}^{}" | awk 'NR == 1 { print $1 }')"
  [ "$remote_commit" = "$commit" ] ||
    die "remote tag ${tag} is missing, is not annotated, or does not point to ${commit}"
}

remote_tags() {
  git ls-remote --tags --refs origin "refs/tags/$1" |
    awk '{ sub("refs/tags/", "", $2); print $2 }' |
    sort -Vr
}

cut_tag() {
  local bump="$1"
  local release_candidate="$2"

  local branch
  branch="$(git symbolic-ref --quiet --short HEAD || true)"
  [ "$branch" = "main" ] || die "releases must be cut from main (got ${branch:-detached HEAD})"
  require_clean
  local head
  head="$(git rev-parse HEAD)"
  require_current_main "$head"

  make fmt-check vet test test-stub

  local latest="" t
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    if [[ "$t" =~ $STABLE_TAG_RE ]]; then
      latest="$t"
      break
    fi
  done < <(remote_tags "${TAG_PREFIX}*")

  local base
  if [ -z "$latest" ]; then
    base="0.0.0"
    echo "No existing ${TAG_PREFIX}* release tag; basing bump on v0.0.0."
  else
    if ! main_stamped_for "$latest"; then
      [ "${RELEASE_DRY_RUN:-}" != "1" ] ||
        die "actions/verify on main isn't stamped for ${latest}; rerun without RELEASE_DRY_RUN to open its stamp pull request"
      open_stamp_pr "$latest"
      echo "Merge the stamp pull request, then rerun to cut the next release."
      return
    fi
    base="${latest#"$TAG_PREFIX"}"
  fi

  local major rest minor patch version tag
  major="${base%%.*}"
  rest="${base#*.}"
  minor="${rest%%.*}"
  patch="${rest#*.}"
  case "$bump" in
    major) major=$((major + 1)); minor=0; patch=0 ;;
    minor) minor=$((minor + 1)); patch=0 ;;
    patch) patch=$((patch + 1)) ;;
  esac

  version="v${major}.${minor}.${patch}"
  tag="${TAG_PREFIX}${major}.${minor}.${patch}"
  if [ "$release_candidate" = "1" ]; then
    local candidate rc=0 n
    while IFS= read -r candidate; do
      [[ "$candidate" =~ $TAG_RE ]] || continue
      n="${candidate##*.}"
      [ "$n" -gt "$rc" ] && rc="$n"
    done < <(remote_tags "${tag}-rc.*")
    tag="${tag}-rc.$((rc + 1))"
  fi
  validate_tag "$tag"
  # A rerun after a held push reuses the local tag if it's the one it would create.
  local reuse=0
  if git rev-parse -q --verify "refs/tags/${tag}" >/dev/null; then
    [ "$(git cat-file -t "refs/tags/${tag}")" = tag ] ||
      die "local tag ${tag} is not annotated; delete it and rerun"
    [ "$(git rev-parse "${tag}^{commit}")" = "$head" ] ||
      die "local tag ${tag} points at $(git rev-parse --short "${tag}^{commit}"), not HEAD; delete it and rerun"
    reuse=1
  fi

  echo "Cutting ${tag} (module version ${version}) at $(git rev-parse --short HEAD)"
  if [ "${RELEASE_DRY_RUN:-}" = "1" ]; then
    echo "RELEASE_DRY_RUN=1 set; stopping before tag and push."
    return
  fi

  if [ "$release_candidate" = "0" ]; then
    gh auth status >/dev/null 2>&1 ||
      die "sign in with gh first; it opens main's stamp pull request after the tag is pushed"
  fi
  if [ "$reuse" = "1" ]; then
    echo "Reusing local tag ${tag}."
  else
    git tag -a "$tag" -m "$tag"
  fi
  local commit
  commit="$(git rev-parse "${tag}^{commit}")"
  require_current_main "$commit"
  git push origin "refs/tags/${tag}"
  require_remote_annotated_tag "$tag" "$commit"
  echo "Pushed ${tag}; the tag workflow will create the release."
  # main carries stable releases only.
  if [ "$release_candidate" = "0" ]; then
    open_stamp_pr "$tag"
    echo "Merge the stamp pull request before the next release."
  fi
}

case "${1:-}" in
  patch | minor | major)
    if [ "$#" -eq 1 ]; then
      cut_tag "$1" 0
    elif [ "$#" -eq 2 ] && [ "$2" = "--rc" ]; then
      cut_tag "$1" 1
    else
      die "usage: script/release <patch|minor|major> [--rc]"
    fi
    ;;
  *)
    die "usage: script/release <patch|minor|major> [--rc]"
    ;;
esac
